function normalizeCountryName(name) {
    const aliases = {
        "United States": "United States of America",
        "Russia": "Russia",
        "South Korea": "South Korea",
        "North Korea": "North Korea",
        "Czech Republic": "Czechia",
        "Ivory Coast": "Cote d'Ivoire",
        "Sao Tome and Principe": "Sao Tome and Principe"
    };

    return aliases[name] || name;
}

function getCountryFeature(country) {
    if (!globeCountries) return null;

    const wanted = normalizeCountryName(country[1]).toLowerCase();

    return globeCountries.find(feature => {
        const name = feature.properties && feature.properties.name;
        return name && name.toLowerCase() === wanted;
    }) || null;
}

function getFeatureBoundaryPoints(feature) {
    const points = [];

    function collect(coords) {
        if (!Array.isArray(coords) || coords.length === 0) return;

        if (typeof coords[0] === "number") {
            points.push(coords);
            return;
        }

        coords.forEach(collect);
    }

    collect(feature.geometry.coordinates);
    return points;
}

function pointToSegmentDistance(point, a, b) {
    // Approximate the Earth locally using latitude/longitude.
    const latScale = 111.32;
    const lonScale = 111.32 * Math.cos(point[1] * Math.PI / 180);

    const px = point[0] * lonScale;
    const py = point[1] * latScale;
    const ax = a[0] * lonScale;
    const ay = a[1] * latScale;
    const bx = b[0] * lonScale;
    const by = b[1] * latScale;

    const dx = bx - ax;
    const dy = by - ay;

    if (dx === 0 && dy === 0) {
        return Math.hypot(px - ax, py - ay);
    }

    const t = Math.max(
        0,
        Math.min(
            1,
            ((px - ax) * dx + (py - ay) * dy) /
            (dx * dx + dy * dy)
        )
    );

    const closestX = ax + t * dx;
    const closestY = ay + t * dy;

    return Math.hypot(px - closestX, py - closestY);
}

function getBoundaryLines(feature) {
    const lines = [];

    function collect(coords) {
        if (!Array.isArray(coords) || coords.length === 0) return;

        if (
            Array.isArray(coords[0]) &&
            coords[0].length > 0 &&
            typeof coords[0][0] === "number"
        ) {
            lines.push(coords);
            return;
        }

        coords.forEach(collect);
    }

    collect(feature.geometry.coordinates);
    return lines;
}

function distanceBetweenFeatures(featureA, featureB) {
    const linesA = getBoundaryLines(featureA);
    const linesB = getBoundaryLines(featureB);

    let shortest = Infinity;

    // Find the shortest distance from a boundary point on one country
    // to a boundary segment on the other country.
    for (const lineA of linesA) {
        for (const lineB of linesB) {

            for (let i = 0; i < lineA.length; i += 2) {
                const pointA = lineA[i];

                for (let j = 0; j < lineB.length - 1; j += 2) {
                    const distance = pointToSegmentDistance(
                        pointA,
                        lineB[j],
                        lineB[j + 1]
                    );

                    if (distance < shortest) {
                        shortest = distance;
                    }
                }
            }

            // Also check the opposite direction.
            for (let j = 0; j < lineB.length; j += 2) {
                const pointB = lineB[j];

                for (let i = 0; i < lineA.length - 1; i += 2) {
                    const distance = pointToSegmentDistance(
                        pointB,
                        lineA[i],
                        lineA[i + 1]
                    );

                    if (distance < shortest) {
                        shortest = distance;
                    }
                }
            }
        }
    }

    return shortest;
}

function colorGuess(country) {

    const guessedFeature = getCountryFeature(country);
    const targetFeature = getCountryFeature(globleTarget);

    if (!guessedFeature || !targetFeature) return null;

    const distanceKm = distanceBetweenFeatures(
        guessedFeature,
        targetFeature
    );

    // 0 km = dark red.
    // As the distance increases, the red becomes lighter.
    const maxDistance = 10000;

    const intensity = Math.max(
        0,
        Math.min(1, 1 - distanceKm / maxDistance)
    );

    const red = 255;

    // Dark red when close, pale red when far away.
    const green = Math.round(245 - intensity * 175);
    const blue = Math.round(245 - intensity * 175);

    const fill = `rgb(${red}, ${green}, ${blue})`;

    globeSVG
        .selectAll(".country")
        .filter(d => d === guessedFeature)
        .classed("guess", true)
        .style("fill", fill);

    return distanceKm;
}

function showGlobleScoreboard() {
    const scoreboard = document.getElementById("globleScoreboard");
    const list = document.getElementById("globleScoreList");
    const count = document.getElementById("globleGuessCount");
    const countdown = document.getElementById("globleCountdown");

    list.innerHTML = "";

    globleGuessed.forEach((country, index) => {
        const row = document.createElement("div");
        row.className = "score-row" +
