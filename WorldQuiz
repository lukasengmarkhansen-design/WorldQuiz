async function createGlobe() {

    globeSVG = d3.select("#globe");

    const width = 600;
    const height = 600;

    projection = d3.geoOrthographic()
        .scale(285)
        .translate([
            width / 2,
            height / 2
        ])
        .clipAngle(90);

    globePath = d3.geoPath()
        .projection(projection);


    const world = await fetch(
        "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-50m.json"
    ).then(response => response.json());


    const countryData = topojson.feature(
        world,
        world.objects.countries
    );

    globeCountries = countryData.features;


    globeSVG
        .selectAll(".country")
        .data(countryData.features)
        .enter()
        .append("path")
        .attr("class", "country")
        .attr("d", globePath);


    globeSVG
        .append("circle")
        .attr("class", "globe-border")
        .attr("cx", width / 2)
        .attr("cy", height / 2)
        .attr("r", 285);


    /* ====================================================
       ROTATION
    ==================================================== */

    let isDragging = false;

    let startX = 0;
    let startY = 0;

    let startRotation = [0, 0];


    const container =
        document.getElementById("globeContainer");


    container.addEventListener(
        "mousedown",
        function(event) {

            isDragging = true;

            startX = event.clientX;
            startY = event.clientY;

            startRotation =
                projection.rotate().slice();
        }
    );


    window.addEventListener(
        "mousemove",
        function(event) {

            if (!isDragging) return;


            const dx =
                event.clientX - startX;

            const dy =
                event.clientY - startY;


            const rotation =
                startRotation.slice();


            rotation[0] =
                startRotation[0] + dx * 0.5;

            rotation[1] =
                startRotation[1] - dy * 0.5;


            rotation[1] =
                Math.max(
                    -90,
                    Math.min(90, rotation[1])
                );


            projection.rotate(rotation);


            globeSVG
                .selectAll(".country")
                .attr("d", globePath);
        }
    );


    window.addEventListener(
        "mouseup",
        function() {
            isDragging = false;
        }
    );


    /* TOUCH */

    container.addEventListener(
        "touchstart",
        function(event) {

            if (event.touches.length !== 1) return;

            const touch =
                event.touches[0];

            isDragging = true;

            startX = touch.clientX;
            startY = touch.clientY;

            startRotation =
                projection.rotate().slice();

        },
        { passive: false }
    );


    container.addEventListener(
        "touchmove",
        function(event) {

            if (!isDragging) return;

            if (event.touches.length !== 1) return;

            event.preventDefault();

            const touch =
                event.touches[0];


            const dx =
                touch.clientX - startX;

            const dy =
                touch.clientY - startY;


            const rotation =
                startRotation.slice();


            rotation[0] =
                startRotation[0] + dx * 0.5;

            rotation[1] =
                startRotation[1] - dy * 0.5;


            rotation[1] =
                Math.max(
                    -90,
                    Math.min(90, rotation[1])
                );


            projection.rotate(rotation);


            globeSVG
                .selectAll(".country")
                .attr("d", globePath);

        },
        { passive: false }
    );


    container.addEventListener(
        "touchend",
        function() {

            isDragging = false;

        }
    );
}


