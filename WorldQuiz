        list.appendChild(row);
    });

    count.textContent =
        "Total guesses: " + globleGuessed.length;

    scoreboard.classList.remove("hidden");

    let secondsLeft = 10;
    countdown.textContent =
        "New round in " + secondsLeft + " seconds...";

    if (globleCountdownTimer) {
        clearInterval(globleCountdownTimer);
    }

    globleCountdownTimer = setInterval(() => {
        secondsLeft--;

        if (secondsLeft > 0) {
            countdown.textContent =
                "New round in " + secondsLeft + " seconds...";
        } else {
            clearInterval(globleCountdownTimer);
            globleCountdownTimer = null;
        }
    }, 1000);
}



function getCountryCenter(feature) {
    if (!feature) return null;

    const points = [];

    function collect(coords) {
        if (!coords) return;

        if (typeof coords[0] === "number") {
            points.push(coords);
        } else {
            coords.forEach(collect);
        }
    }

    collect(feature.geometry.coordinates);

    if (!points.length) return null;

    let lon = 0;
    let lat = 0;

    points.forEach(p => {
        lon += p[0];
        lat += p[1];
    });

    return [lon / points.length, lat / points.length];
}

function getDirection(fromFeature, toFeature) {
    const from = getCountryCenter(fromFeature);
    const to = getCountryCenter(toFeature);

    if (!from || !to) return "→";

    const lat1 = from[1] * Math.PI / 180;
    const lon1 = from[0] * Math.PI / 180;
    const lat2 = to[1] * Math.PI / 180;
    const lon2 = to[0] * Math.PI / 180;

    const y = Math.sin(lon2 - lon1) * Math.cos(lat2);
    const x =
        Math.cos(lat1) * Math.sin(lat2) -
        Math.sin(lat1) * Math.cos(lat2) *
        Math.cos(lon2 - lon1);

    let bearing = Math.atan2(y, x) * 180 / Math.PI;
    bearing = (bearing + 360) % 360;

    if (bearing < 22.5 || bearing >= 337.5) return "N ↑";
    if (bearing < 67.5) return "NE ↗";
    if (bearing < 112.5) return "E →";
    if (bearing < 157.5) return "SE ↘";
    if (bearing < 202.5) return "S ↓";
    if (bearing < 247.5) return "SW ↙";
    if (bearing < 292.5) return "W ←";
    return "NW ↖";
}

function updateGlobleGuessList() {
    const list = document.getElementById("globleGuessList");
    if (!list || !globleTarget || !globeCountries) return;

    list.innerHTML = "";

    const targetFeature = getCountryFeature(globleTarget);

    globleGuessed.forEach(country => {
        const guessedFeature = getCountryFeature(country);

        const row = document.createElement("div");
        row.className = "globle-guess-row";

        const name = document.createElement("div");
        name.textContent = country[1];

        const distance = document.createElement("div");
        distance.className = "globle-guess-distance";

        const direction = document.createElement("div");
        direction.className = "globle-guess-direction";

        if (guessedFeature && targetFeature) {
            const km = distanceBetweenFeatures(
                guessedFeature,
                targetFeature
            );

            distance.textContent =
                km < 1 ? "0 km" : Math.round(km) + " km";

            direction.textContent =
                getDirection(guessedFeature, targetFeature);
        } else {
            distance.textContent = "—";
            direction.textContent = "—";
        }

        row.appendChild(name);
        row.appendChild(distance);
        row.appendChild(direction);
        list.appendChild(row);
    });
}


function globleGuess() {

    // Ingen nye gæt mens scoreboardet vises.
    if (!document.getElementById("globleScoreboard").classList.contains("hidden")) {
        return;
    }

    const input = document.getElementById("globleInput");
    const answer = input.value.trim();
    const message = document.getElementById("globleMessage");

    if (answer === "") return;

    const country = countries.find(
        c => c[1].toLowerCase() === answer.toLowerCase()
    );

    if (!country) {
        message.textContent = "Country not found.";
        message.style.color = "#ff6565";
        input.value = "";
        input.focus();
        return;
    }

    // Undgå at gætte samme land flere gange
    if (globleGuessed.some(c => c[0] === country[0])) {
        message.textContent = "You already guessed that country.";
        message.style.color = "#ffcc66";
        input.value = "";
        input.focus();
        return;
    }

    globleGuessed.push(country);
    updateGlobleGuessList();

    if (country[0] === globleTarget[0]) {

        message.textContent =
            "Correct! You found " + globleTarget[1] + "!";
        message.style.color = "#4cff91";

        // Vis scoreboardet i de 10 sekunder, hvor vi venter.
        document.getElementById("globleInput").disabled = true;
        document.getElementById("globleGuessButton").disabled = true;
        showGlobleScoreboard();
        document.getElementById("globleGuessList").classList.add("hidden");

        // Farv det rigtige land grønt
        const correctFeature = getCountryFeature(country);
        if (correctFeature) {
            globeSVG
                .selectAll(".country")
                .filter(d => d === correctFeature)
                .classed("guess-correct", true)
                .style("fill", "#4cff91");
        }

        // Start automatisk en ny runde efter 10 sekunder
        globleNewRoundTimer = setTimeout(() => {
            if (globleCountdownTimer) {
                clearInterval(globleCountdownTimer);
                globleCountdownTimer = null;
            }
            startGloble();
        }, 10000);

        return;

    } else {

        const distanceKm = colorGuess(country);

        if (distanceKm !== null) {
            const km = Math.round(distanceKm);

            if (km < 1) {
                message.textContent =
                    "Wrong! The countries share a border.";
            } else if (km < 10) {
                message.textContent =
                    "Wrong! Less than 10 km to the closest border.";
            } else {
                message.textContent =
                    "Wrong! " + km +
                    " km to the closest border.";
            }
        } else {
            message.textContent =
                "Wrong! Try another country.";
        }

        message.style.color = "#ffffff";
    }

    input.value = "";
    input.focus();
}


