let quizFlags = [];
let currentIndex = 0;
let score = 0;
let attempts = 5;


function startFlagQuiz() {

    document.getElementById("menuScreen").classList.add("hidden");
    document.getElementById("globleScreen").classList.add("hidden");
    document.getElementById("endScreen").classList.add("hidden");

    document.getElementById("gameScreen").classList.remove("hidden");

    quizFlags = [...flagQuizCountries];

    quizFlags.sort(() => Math.random() - 0.5);

    currentIndex = 0;
    score = 0;
    attempts = 5;

    showFlag();
}


function showFlag() {

    if (currentIndex >= quizFlags.length) {
        endGame();
        return;
    }

    const flag = quizFlags[currentIndex];

    document.getElementById("flag").src =
        "https://flagcdn.com/w640/" +
        flag[0] +
        ".png";

    document.getElementById("progress").textContent =
        "Flag " +
        (currentIndex + 1) +
        " / " +
        quizFlags.length;

    document.getElementById("score").textContent =
        "Score: " + score;

    attempts = 5;

    updateAttempts();

    document.getElementById("message").textContent = "";

    document.getElementById("answer").value = "";

    document.getElementById("answer").focus();
}


function updateAttempts() {

    document.getElementById("attemptText").textContent =
        "Guesses left: " + attempts;

    let hearts = "";

    for (let i = 0; i < attempts; i++) {
        hearts += "❤️ ";
    }

    document.getElementById("hearts").textContent = hearts;
}


function checkAnswer() {

    const input = document.getElementById("answer");

    const answer =
        input.value.trim().toLowerCase();

    if (answer === "") return;

    const correctAnswer =
        quizFlags[currentIndex][1].toLowerCase();

    if (answer === correctAnswer) {

        score++;

        document.getElementById("message").textContent =
            "Correct! It is " +
            quizFlags[currentIndex][1];

        document.getElementById("message").className =
            "message correct";

        currentIndex++;

        setTimeout(showFlag, 800);

    } else {

        attempts--;

        updateAttempts();

        if (attempts <= 0) {

            document.getElementById("message").textContent =
                "Wrong! The answer was " +
                quizFlags[currentIndex][1];

            document.getElementById("message").className =
                "message wrong";

            currentIndex++;

            setTimeout(showFlag, 1500);

        } else {

            document.getElementById("message").textContent =
                "Wrong! Try again.";

            document.getElementById("message").className =
                "message wrong";

            input.value = "";
            input.focus();
        }
    }
}


